# =========================================================
# Vanta Network — environment variables
# Copy this file to .env and fill in real values.
# Never commit your real .env file.
# =========================================================

# ---------- Shared ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- Database ----------
# Local dev default matches docker-compose.dev.yml
DATABASE_URL=postgresql://vanta:vanta_dev_password@localhost:5432/vanta?schema=public

# ---------- API service (services/api) ----------
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of allowed CORS origins
API_CORS_ORIGINS=http://localhost:5173

# JWT secret used to sign session/auth tokens. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_value
JWT_EXPIRES_IN=12h

# Password hashing (argon2) cost parameters — safe defaults, tune per host
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---------- Realtime service (services/realtime) ----------
REALTIME_PORT=4001
REALTIME_HOST=0.0.0.0
# Shared secret used by the realtime server to verify tokens issued by the API
REALTIME_JWT_SECRET=replace_this_with_the_same_value_as_JWT_SECRET
# Position update rate accepted from clients (Hz). Server clamps/throttles above this.
REALTIME_MAX_UPDATE_HZ=2
# Seconds of silence before a connection is considered dead
REALTIME_HEARTBEAT_TIMEOUT_SECONDS=30

# ---------- Voice service (services/voice) — scaffold, Phase 16 ----------
VOICE_PORT=4002
VOICE_HOST=0.0.0.0
# STUN server for WebRTC NAT traversal (free, public, no account needed)
VOICE_STUN_URL=stun:stun.l.google.com:19302
# Default VHF-style radio range in nautical miles used until line-of-sight model lands
VOICE_DEFAULT_RANGE_NM=200

# ---------- Web app (apps/web) — Vite env, must be prefixed VITE_ ----------
VITE_API_BASE_URL=http://localhost:4000
VITE_REALTIME_WS_URL=ws://localhost:4001
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# ---------- Windows Client (apps/client) ----------
CLIENT_API_BASE_URL=http://localhost:4000
CLIENT_REALTIME_WS_URL=ws://localhost:4001

# ---------- Airport data importer (packages/airport-data) ----------
OURAIRPORTS_BASE_URL=https://davidmegginson.github.io/ourairports-data
