{
  "name": "vanta-network",
  "private": true,
  "version": "0.1.0",
  "description": "Vanta Network — a free, community-run flight simulation network for MSFS 2020 and MSFS 2024",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/** run build && pnpm -r --filter=./services/** run build && pnpm -r --filter=./apps/** run build",
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @vanta/api run dev",
    "dev:realtime": "pnpm --filter @vanta/realtime run dev",
    "dev:web": "pnpm --filter @vanta/web run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @vanta/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @vanta/api exec prisma generate",
    "airports:import": "pnpm --filter @vanta/airport-data run import",
    "clean": "pnpm -r exec rimraf dist node_modules && rimraf node_modules"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.2"
  }
}
